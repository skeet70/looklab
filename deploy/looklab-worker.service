# /etc/systemd/system/looklab-worker.service
[Unit]
Description=looklab job runner and site publisher
After=network.target looklab-server.service

[Service]
Type=simple
User=looklab
Group=looklab
ExecStart=/usr/local/bin/looklab-worker \
    --db /var/lib/looklab/looklab.sqlite3 \
    --blobs /var/lib/looklab/blobs \
    --data /var/lib/looklab/data \
    --transforms /var/lib/looklab/data/transforms \
    --site /var/lib/looklab/site \
    --lease-seconds 300
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=600
StateDirectory=looklab
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/looklab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
